PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-secure-random-secret-key-in-production

# Core Database (PostgreSQL)
DATABASE_URL=postgresql://conversio_admin:conversio_secure_db_password_2026@localhost:5432/conversio
POSTGRES_USER=conversio_admin
POSTGRES_PASSWORD=conversio_secure_db_password_2026
POSTGRES_DB=conversio

# In-Memory Cache (Redis)
REDIS_URL=redis://localhost:6379

IDEMPOTENCY_TTL_SECONDS=86400
LOCK_MUTEX_TTL_SECONDS=15

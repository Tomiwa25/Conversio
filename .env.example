# ==============================================================================
# CONVERSIO ROOT ENVIRONMENT CONFIGURATION
# ==============================================================================
# This file documents all environment variables used across Conversio services.
# Copy this file to .env for local development or set these variables in production.

# ------------------------------------------------------------------------------
# 1. Backend Server Configuration (apps/server)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Cryptographic secret for signing room admission tokens (JWT HMAC-SHA256)
JWT_SECRET=replace-with-a-secure-random-secret-key-in-production

# Core Relational Database: PostgreSQL Connection String
# Used for durable persistence, room metadata, OCC versioning, and audit logs.
# If omitted or unreachable, backend falls back gracefully to in-memory state.
DATABASE_URL=postgresql://conversio_admin:conversio_secure_db_password_2026@localhost:5432/conversio
POSTGRES_USER=conversio_admin
POSTGRES_PASSWORD=conversio_secure_db_password_2026
POSTGRES_DB=conversio

# In-Memory Cache: Redis connection string
# Used for fast in-flight idempotency mutexing and Socket.io horizontal multi-pod clustering.
# If omitted or unreachable, backend falls back gracefully to in-memory state.
REDIS_URL=redis://localhost:6379

# Idempotency Engine & Concurrency Lock Time-To-Live (in seconds)
IDEMPOTENCY_TTL_SECONDS=86400 # 24 hours cache for completed room creation payloads
LOCK_MUTEX_TTL_SECONDS=15     # In-flight mutex lock TTL preventing race conditions

# LiveKit SFU Real-Time Media Engine Credentials
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ------------------------------------------------------------------------------
# 2. Frontend Client Configuration (apps/client)
# ------------------------------------------------------------------------------
# Signaling backend API URL accessible by browser clients
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# STUN Servers for NAT Traversal (public Google STUN relays)
NEXT_PUBLIC_STUN_SERVER_1=stun:stun.l.google.com:19302
NEXT_PUBLIC_STUN_SERVER_2=stun:stun1.l.google.com:19302

# Optional TURN Relay Configuration (Required for Symmetric NAT / Corporate Firewalls)
# Defaults match the bundled Docker Coturn service
NEXT_PUBLIC_TURN_SERVER_URL=turn:localhost:3478
NEXT_PUBLIC_TURN_USERNAME=conversio_user
NEXT_PUBLIC_TURN_CREDENTIAL=conversio_secret_password
